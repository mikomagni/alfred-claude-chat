{
  "log": {
    "level": "info",
    "internal": true
  },
  "iconpath": "../icon.png",
  "variablesconfig": {
    "claude_path": {
      "src": "variable",
      "scriptenv": true
    },
    "api_key": {
      "src": "variable",
      "scriptenv": true
    },
    "model_id": {
      "src": "variable",
      "scriptenv": true
    },
    "custom_instructions": {
      "src": "variable",
      "scriptenv": true
    },
    "max_context": {
      "src": "variable",
      "scriptenv": true
    },
    "timeout_seconds": {
      "src": "variable",
      "scriptenv": true
    },
    "stop_streaming": {
      "default": false,
      "scriptenv": true
    }
  },
  "variables": {
    "current_chat_file": null,
    "preset": "",
    "attachments": "",
    "new_chat": [
      {
        "type": "json",
        "src": {
          "variables": {
            "current_chat_file": null
          },
          "update": {
            "ids": {
              "chatArea": {
                "behaviour": {
                  "mode": "replace"
                }
              },
              "promptField": {
                "focus": true
              }
            }
          }
        }
      },
      {
        "type": "function",
        "src": "chatList",
        "args": "selectnone"
      }
    ],
    "submit_prompt": [
      {
        "type": "script",
        "src": "scripts/prepare-for-streaming",
        "args": [
          "{var:current_chat_file}",
          "{value:promptField.text}",
          "{var:preset}",
          "{var:attachments}"
        ]
      },
      {
        "type": "script",
        "async": true,
        "src": "scripts/submit-prompt",
        "args": [
          "{var:current_chat_file}",
          "{value:promptField.text}",
          "{var:preset}",
          "",
          "",
          "{var:attachments}"
        ]
      }
    ]
  },
  "pulse": {
    "interval": 0.5,
    "intervalmode": "delay",
    "src": "scripts/pulse",
    "args": "{var:current_chat_file}"
  },
  "window": {
    "title": "Claude Chat",
    "titlevisibility": false,
    "titlebarappearstransparent": true,
    "fullsizecontentview": true,
    "blur": true,
    "toolbar": {
      "type": "unified"
    },
    "size": {
      "width": 800,
      "height": 600
    },
    "root": {
      "type": "view",
      "layout": "border",
      "components": [
        {
          "constraints": {
            "region": "left",
            "size": {
              "width": 256
            }
          },
          "type": "view",
          "layout": "border",
          "components": [
            {
              "constraints": {
                "region": "top",
                "position": "right",
                "insets": {
                  "top": 2
                }
              },
              "type": "view",
              "layout": "inline",
              "padding": 8,
              "spacing": 8,
              "components": [
                {
                  "constraints": {
                    "size": 32
                  },
                  "id": "newChatButton",
                  "type": "button",
                  "image": {
                    "type": "symbol",
                    "src": "plus"
                  },
                  "font": {
                    "size": 16
                  },
                  "bordershape": "circle",
                  "effect": "glass",
                  "shortcut": "⌘N",
                  "tooltip": "New Chat ⌘N",
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": "{var:new_chat}"
                    }
                  ]
                },
                {
                  "constraints": {
                    "size": 32
                  },
                  "id": "deleteAllButton",
                  "type": "button",
                  "image": {
                    "type": "symbol",
                    "src": "flame"
                  },
                  "font": {
                    "size": 16
                  },
                  "bordershape": "circle",
                  "effect": "glass",
                  "shortcut": "⌘⇧⌫",
                  "tooltip": "Delete All Chats ⌘⇧⌫",
                  "events": [
                    {
                      "triggers": "actioned",
                      "confirm": {
                        "message": "Delete All Chats?",
                        "informativetext": "They will be sent to the trash.",
                        "confirmbuttontext": "Delete"
                      },
                      "action": [
                        {
                          "type": "script",
                          "src": "scripts/delete-all-chats"
                        },
                        {
                          "type": "script",
                          "src": "scripts/load-chat-list"
                        },
                        "{var:new_chat}"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "constraints": {
                "region": "centre"
              },
              "type": "view",
              "layout": "border",
              "padding": 8,
              "spacing": 8,
              "components": [
                {
                  "constraints": {
                    "region": "top"
                  },
                  "type": "view",
                  "layout": "stack",
                  "background": "#00000033",
                  "cornerradius": 6,
                  "components": [
                    {
                      "id": "chatSearch",
                      "type": "textfield",
                      "placeholder": "Search chats",
                      "bordered": false,
                      "background": null,
                      "focusring": false,
                      "font": {
                        "size": 13
                      },
                      "textinsets": {
                        "horizontal": 8,
                        "vertical": 6
                      },
                      "tooltip": "Search Chats ⌘F",
                      "events": [
                        {
                          "triggers": "changed",
                          "action": {
                            "type": "function",
                            "src": "chatList",
                            "args": "filterdata"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "constraints": {
                    "region": "centre"
                  },
                  "type": "view",
                  "layout": "stack",
                  "components": [
                    {
                      "constraints": {
                        "position": "centre"
                      },
                      "id": "chatListEmpty",
                      "type": "label",
                      "text": "No chats yet",
                      "colour": "secondaryLabelColor",
                      "hidden": true
                    },
                    "{file:chatlist.json}"
                  ]
                }
              ]
            }
          ]
        },
        {
          "constraints": {
            "region": "centre"
          },
          "type": "view",
          "layout": "border",
          "background": {
            "light": "#ffffff77",
            "dark": "#00000077"
          },
          "padding": 16,
          "spacing": 8,
          "components": [
            {
              "constraints": {
                "region": "centre"
              },
              "id": "chatArea",
              "type": "markdownarea",
              "background": null,
              "autoadjustcontentinsets": false,
              "urischemes": [
                "http",
                "https",
                "file"
              ]
            },
            {
              "constraints": {
                "region": "bottom",
                "size": {
                  "height": 112
                }
              },
              "type": "view",
              "layout": "border",
              "padding": 8,
              "spacing": 8,
              "background": "#00000033",
              "cornerradius": 8,
              "components": [
                {
                  "constraints": {
                    "region": "centre"
                  },
                  "id": "promptField",
                  "type": "textfield",
                  "placeholder": "Ask Claude",
                  "multiline": true,
                  "linebreak": "wrap",
                  "bordered": false,
                  "background": null,
                  "focus": true,
                  "focusring": false,
                  "font": {
                    "size": 16
                  },
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": "{var:submit_prompt}"
                    }
                  ]
                },
                {
                  "id": "controlsRow",
                  "constraints": {
                    "region": "bottom"
                  },
                  "type": "view",
                  "layout": "border",
                  "components": [
                    {
                      "constraints": {
                        "region": "centre"
                      },
                      "type": "view",
                      "layout": "stack",
                      "components": [
                        {
                          "constraints": {
                            "position": "left"
                          },
                          "id": "presetsButton",
                          "type": "button",
                          "bordered": false,
                          "font": {
                            "size": 13
                          },
                          "contenttintcolour": "labelColor",
                          "text": "Presets",
                          "shortcut": "⌘P",
                          "tooltip": "Choose a preset for your next message ⌘P",
                          "events": [
                            {
                              "triggers": "actioned",
                              "action": {
                                "type": "script",
                                "src": "scripts/presets",
                                "args": [
                                  "menu",
                                  "{var:preset}"
                                ]
                              }
                            }
                          ]
                        },
                        {
                          "id": "attachmentsButton",
                          "type": "button",
                          "bordered": false,
                          "font": {
                            "size": 12
                          },
                          "contenttintcolour": "labelColor",
                          "text": "",
                          "hidden": true,
                          "tooltip": "Files that will be sent with your next message. Click to remove them",
                          "events": [
                            {
                              "triggers": "actioned",
                              "action": {
                                "type": "script",
                                "src": "scripts/attach",
                                "args": [
                                  "menu",
                                  "{var:attachments}"
                                ]
                              }
                            }
                          ],
                          "constraints": {
                            "position": "right",
                            "insets": {
                              "right": 10
                            }
                          }
                        }
                      ]
                    },
                    {
                      "id": "modelPicker",
                      "constraints": {
                        "region": "left"
                      },
                      "type": "picker",
                      "font": {
                        "size": 13
                      },
                      "items": [
                        {
                          "text": "Sonnet",
                          "value": "sonnet"
                        },
                        {
                          "text": "Opus",
                          "value": "opus"
                        },
                        {
                          "text": "Haiku",
                          "value": "haiku"
                        },
                        {
                          "type": "separator"
                        },
                        {
                          "text": "Fable",
                          "value": "fable"
                        },
                        {
                          "text": "Best available",
                          "value": "best"
                        },
                        {
                          "text": "Opus (1M context)",
                          "value": "opus[1m]"
                        },
                        {
                          "type": "separator"
                        },
                        {
                          "text": "Opus 5",
                          "value": "claude-opus-5"
                        },
                        {
                          "text": "Sonnet 5",
                          "value": "claude-sonnet-5"
                        },
                        {
                          "text": "Opus 4.8",
                          "value": "claude-opus-4-8"
                        },
                        {
                          "text": "Fable 5",
                          "value": "claude-fable-5"
                        },
                        {
                          "type": "separator"
                        },
                        {
                          "text": "Default",
                          "value": "default"
                        }
                      ],
                      "events": [
                        {
                          "triggers": "changed",
                          "action": {
                            "type": "script",
                            "src": "scripts/model-picker",
                            "args": [
                              "save",
                              "{value:self.selected.value}"
                            ]
                          }
                        }
                      ],
                      "bordered": false
                    },
                    {
                      "constraints": {
                        "region": "right"
                      },
                      "type": "view",
                      "layout": "inline",
                      "direction": "horizontal",
                      "spacing": 10,
                      "components": [
                        {
                          "id": "attachButton",
                          "type": "button",
                          "bordered": false,
                          "font": {
                            "size": 14
                          },
                          "image": {
                            "type": "symbol",
                            "src": "paperclip"
                          },
                          "contenttintcolour": "secondaryLabelColor",
                          "tooltip": "Attach files. ⌘⇧V attaches what is on the clipboard",
                          "events": [
                            {
                              "triggers": "actioned",
                              "action": {
                                "type": "json",
                                "src": {
                                  "opendialog": {
                                    "multiselect": true,
                                    "prompt": "Attach",
                                    "message": "Choose files to send with your next message",
                                    "setvariable": "picked_files",
                                    "action": {
                                      "type": "script",
                                      "src": "scripts/attach",
                                      "args": [
                                        "add",
                                        "{var:attachments}",
                                        "{var:picked_files}"
                                      ]
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        },
                        {
                          "id": "pasteReplyButton",
                          "type": "button",
                          "bordered": false,
                          "font": {
                            "size": 14
                          },
                          "image": {
                            "type": "symbol",
                            "src": "arrow.down.doc"
                          },
                          "contenttintcolour": "secondaryLabelColor",
                          "tooltip": "Paste the last reply into the app you came from, and close ⌘⇧↩",
                          "events": [
                            {
                              "triggers": "actioned",
                              "action": {
                                "type": "script",
                                "src": "scripts/paste-reply",
                                "args": "{var:current_chat_file}"
                              }
                            }
                          ]
                        },
                        {
                          "id": "regenerateButton",
                          "type": "button",
                          "bordered": false,
                          "font": {
                            "size": 14
                          },
                          "image": {
                            "type": "symbol",
                            "src": "arrow.clockwise"
                          },
                          "contenttintcolour": "secondaryLabelColor",
                          "shortcut": "⌘R",
                          "tooltip": "Regenerate the last reply ⌘R",
                          "events": [
                            {
                              "triggers": "actioned",
                              "action": {
                                "type": "script",
                                "src": "scripts/regenerate",
                                "args": "{var:current_chat_file}"
                              }
                            }
                          ],
                          "constraints": {
                            "insets": {
                              "top": 4
                            }
                          }
                        },
                        {
                          "id": "submitPromptButton",
                          "type": "button",
                          "bordered": false,
                          "font": {
                            "size": 16
                          },
                          "image": {
                            "type": "symbol",
                            "src": "arrow.up.circle.fill"
                          },
                          "events": [
                            {
                              "triggers": "actioned",
                              "action": "{var:submit_prompt}"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "shortcuts": [
        {
          "shortcut": "⌘F",
          "action": {
            "type": "json",
            "src": {
              "update": {
                "ids": {
                  "chatSearch": {
                    "focus": true
                  }
                }
              }
            }
          }
        },
        {
          "shortcut": "⌥⌘",
          "action": {
            "type": "script",
            "src": "scripts/select-chat",
            "args": "next"
          }
        },
        {
          "shortcut": "⌥⌘",
          "action": {
            "type": "script",
            "src": "scripts/select-chat",
            "args": "previous"
          }
        },
        {
          "shortcut": "⌘⇧V",
          "action": {
            "type": "script",
            "src": "scripts/attach",
            "args": [
              "clipboard",
              "{var:attachments}"
            ]
          }
        },
        {
          "shortcut": "⌘⇧C",
          "action": [
            {
              "type": "script",
              "src": "scripts/copy-response",
              "args": "{var:current_chat_file}"
            },
            {
              "type": "json",
              "src": {
                "copy": {
                  "type": "text",
                  "src": "{var:last_response}"
                },
                "sound": {
                  "src": "Blow"
                }
              }
            }
          ]
        },
        {
          "shortcut": "⌘]",
          "action": {
            "type": "script",
            "src": "scripts/select-chat",
            "args": "next"
          }
        },
        {
          "shortcut": "⌘[",
          "action": {
            "type": "script",
            "src": "scripts/select-chat",
            "args": "previous"
          }
        },
        {
          "shortcut": "⌘⇧↩",
          "action": {
            "type": "script",
            "src": "scripts/paste-reply",
            "args": "{var:current_chat_file}"
          }
        }
      ]
    }
  }
}
