{
  "id": "chatList",
  "type": "dataview",
  "events": [
    {
      "triggers": "launched",
      "action": [
        {
          "type": "script",
          "src": "scripts/load-chat-list",
          "args": "launch"
        },
        {
          "type": "function",
          "src": "chatList",
          "args": "selectfirst"
        },
        {
          "type": "script",
          "src": "scripts/model-picker",
          "args": "init"
        },
        {
          "type": "script",
          "src": "scripts/effort",
          "args": "init"
        }
      ]
    },
    {
      "triggers": "changed",
      "action": {
        "type": "script",
        "src": "scripts/load-chat",
        "args": "{value:self.selected.uid}"
      }
    }
  ],
  "behaviour": {
    "selection": {
      "allowempty": true
    }
  },
  "cell": {
    "height": 32,
    "init": {
      "chatListCell.background": null,
      "chatName.colour": "labelColor",
      "chatListActionButtons.hidden": true,
      "chatListActionButtons.constraints.size.width": 1,
      "chatListCopyButton.contenttintcolour": "labelColor",
      "chatListDeleteButton.contenttintcolour": "labelColor"
    },
    "selected": {
      "chatListCell.background": "alfredSelectedResultBackgroundColor",
      "chatName.colour": "alfredSelectedResultTextColor",
      "chatListActionButtons.hidden": false,
      "chatListActionButtons.constraints.size.width": 0,
      "chatListCopyButton.contenttintcolour": "alfredSelectedResultTextColor",
      "chatListDeleteButton.contenttintcolour": "alfredSelectedResultTextColor"
    },
    "root": {
      "id": "chatListCell",
      "type": "view",
      "layout": "border",
      "padding": 8,
      "spacing": 4,
      "cornerradius": 4,
      "components": [
        {
          "constraints": {
            "region": "centre"
          },
          "id": "chatName",
          "type": "label"
        },
        {
          "constraints": {
            "region": "right"
          },
          "id": "chatListActionButtons",
          "type": "view",
          "layout": "inline",
          "direction": "horizontal",
          "spacing": 4,
          "components": [
            {
              "id": "chatListCopyButton",
              "type": "button",
              "bordered": false,
              "image": {
                "type": "symbol",
                "src": "list.clipboard"
              },
              "font": {
                "size": 16
              },
              "tooltip": "Copy Last Message",
              "events": [
                {
                  "triggers": "actioned",
                  "action": [
                    {
                      "type": "script",
                      "src": "scripts/copy-response",
                      "args": "{data:uid}"
                    },
                    {
                      "type": "json",
                      "src": {
                        "copy": {
                          "type": "text",
                          "src": "{var:last_response}"
                        },
                        "sound": {
                          "src": "Blow"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "chatListDeleteButton",
              "type": "button",
              "bordered": false,
              "image": {
                "type": "symbol",
                "src": "trash"
              },
              "font": {
                "size": 16
              },
              "tooltip": "Delete Chat",
              "events": [
                {
                  "triggers": "actioned",
                  "action": {
                    "type": "json",
                    "variables": {
                      "remove_chat": "{data:uid}"
                    },
                    "src": {
                      "sheet": {
                        "id": "confirmDelete",
                        "root": {
                          "constraints": {
                            "size": {
                              "width": 260
                            }
                          },
                          "type": "view",
                          "layout": "inline",
                          "direction": "vertical",
                          "padding": 20,
                          "spacing": 10,
                          "components": [
                            {
                              "constraints": {
                                "size": 64
                              },
                              "type": "imageview",
                              "image": {
                                "type": "file",
                                "src": "../icon.png"
                              }
                            },
                            {
                              "type": "label",
                              "text": "Delete Chat?",
                              "font": {
                                "weight": "bold"
                              },
                              "textalign": "centre"
                            },
                            {
                              "constraints": {
                                "size": {
                                  "width": 220
                                }
                              },
                              "type": "label",
                              "text": "It will be sent to the Trash, along with its attachments.",
                              "linebreak": "wordwrap",
                              "textalign": "centre"
                            },
                            {
                              "constraints": {
                                "insets": {
                                  "top": 6
                                }
                              },
                              "type": "view",
                              "layout": "inline",
                              "direction": "horizontal",
                              "spacing": 10,
                              "components": [
                                {
                                  "constraints": {
                                    "size": {
                                      "width": 105
                                    }
                                  },
                                  "type": "button",
                                  "text": "Cancel",
                                  "events": [
                                    {
                                      "triggers": "actioned",
                                      "action": {
                                        "type": "json",
                                        "src": {
                                          "sheet": {
                                            "close": "confirmDelete"
                                          }
                                        }
                                      }
                                    }
                                  ]
                                },
                                {
                                  "constraints": {
                                    "size": {
                                      "width": 105
                                    }
                                  },
                                  "type": "button",
                                  "text": "Delete",
                                  "shortcut": "↩",
                                  "events": [
                                    {
                                      "triggers": "actioned",
                                      "action": [
                                        {
                                          "type": "script",
                                          "src": "scripts/delete-chat",
                                          "args": "{var:remove_chat}"
                                        },
                                        {
                                          "type": "json",
                                          "src": {
                                            "sheet": {
                                              "close": "confirmDelete"
                                            },
                                            "update": {
                                              "ids": {
                                                "chatList": {
                                                  "data": {
                                                    "modify": {
                                                      "delete": {
                                                        "uids": [
                                                          "{var:remove_chat}"
                                                        ]
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        },
                                        {
                                          "type": "script",
                                          "src": "scripts/load-chat-list",
                                          "args": "visibility"
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      ],
      "menu": [
        {
          "text": "Copy Last Message",
          "action": [
            {
              "type": "script",
              "src": "scripts/copy-response",
              "args": "{data:uid}"
            },
            {
              "type": "json",
              "src": {
                "copy": {
                  "type": "text",
                  "src": "{var:last_response}"
                },
                "sound": {
                  "src": "Blow"
                }
              }
            }
          ]
        },
        {
          "text": "Copy Chat as Markdown",
          "action": {
            "type": "script",
            "src": "scripts/export-chat",
            "args": [
              "{data:uid}",
              "copy"
            ]
          }
        },
        {
          "text": "Export as Markdown…",
          "action": {
            "type": "script",
            "async": true,
            "src": "scripts/export-chat",
            "args": [
              "{data:uid}",
              "file"
            ]
          }
        },
        {
          "type": "separator"
        },
        {
          "text": "Delete Chat…",
          "action": {
            "type": "json",
            "variables": {
              "remove_chat": "{data:uid}"
            },
            "src": {
              "sheet": {
                "id": "confirmDelete",
                "root": {
                  "constraints": {
                    "size": {
                      "width": 260
                    }
                  },
                  "type": "view",
                  "layout": "inline",
                  "direction": "vertical",
                  "padding": 20,
                  "spacing": 10,
                  "components": [
                    {
                      "constraints": {
                        "size": 64
                      },
                      "type": "imageview",
                      "image": {
                        "type": "file",
                        "src": "../icon.png"
                      }
                    },
                    {
                      "type": "label",
                      "text": "Delete Chat?",
                      "font": {
                        "weight": "bold"
                      },
                      "textalign": "centre"
                    },
                    {
                      "constraints": {
                        "size": {
                          "width": 220
                        }
                      },
                      "type": "label",
                      "text": "It will be sent to the Trash, along with its attachments.",
                      "linebreak": "wordwrap",
                      "textalign": "centre"
                    },
                    {
                      "constraints": {
                        "insets": {
                          "top": 6
                        }
                      },
                      "type": "view",
                      "layout": "inline",
                      "direction": "horizontal",
                      "spacing": 10,
                      "components": [
                        {
                          "constraints": {
                            "size": {
                              "width": 105
                            }
                          },
                          "type": "button",
                          "text": "Cancel",
                          "events": [
                            {
                              "triggers": "actioned",
                              "action": {
                                "type": "json",
                                "src": {
                                  "sheet": {
                                    "close": "confirmDelete"
                                  }
                                }
                              }
                            }
                          ]
                        },
                        {
                          "constraints": {
                            "size": {
                              "width": 105
                            }
                          },
                          "type": "button",
                          "text": "Delete",
                          "shortcut": "↩",
                          "events": [
                            {
                              "triggers": "actioned",
                              "action": [
                                {
                                  "type": "script",
                                  "src": "scripts/delete-chat",
                                  "args": "{var:remove_chat}"
                                },
                                {
                                  "type": "json",
                                  "src": {
                                    "sheet": {
                                      "close": "confirmDelete"
                                    },
                                    "update": {
                                      "ids": {
                                        "chatList": {
                                          "data": {
                                            "modify": {
                                              "delete": {
                                                "uids": [
                                                  "{var:remove_chat}"
                                                ]
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                },
                                {
                                  "type": "script",
                                  "src": "scripts/load-chat-list",
                                  "args": "visibility"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  },
  "hidden": true,
  "placeholder": "No chats found",
  "data": {
    "type": "basic",
    "filter": {
      "type": "basic",
      "args": [
        "chatName.text"
      ],
      "match": "{value:chatSearch.text}"
    },
    "src": []
  }
}
