#!/usr/bin/osascript -l JavaScript

function envVar(varName) {
  return $.NSProcessInfo
    .processInfo
    .environment
    .objectForKey(varName).js
}

function dirContents(dirPathString) {
  return $.NSFileManager
    .defaultManager
    .contentsOfDirectoryAtURLIncludingPropertiesForKeysOptionsError(
      $.NSURL.fileURLWithPath(dirPathString),
      undefined,
      $.NSDirectoryEnumerationSkipsHiddenFiles,
      undefined).js
    ?.sort((a, b) => b.path.js.localeCompare(a.path.js))
}

function readFile(path) {
  return $.NSString.stringWithContentsOfFileEncodingError(path, $.NSUTF8StringEncoding, undefined).js
}

// With "visibility" as the argument, only show or hide the list, leaving its contents and selection alone.
// With "launch", also clear up after a window closed mid-reply
function run(argv) {
  const chatData = dirContents(envVar("alfred_workflow_data"))
    ?.flatMap(url => {
      if (url.pathExtension.js !== "json") return []

      const file = url.path.js
      const first = JSON.parse(readFile(file)).find(entry => entry.role === "user")
      const firstMessage = first.title || first.content

      return {
        "uid": file,
        "chatName.text": firstMessage,
      }
    }) || []

  // An empty list still draws its scrollbar, so hide the list until there's a chat in it
  const empty = chatData.length === 0
  const chatList = { hidden: empty }
  if (argv[0] !== "visibility") chatList.data = { src: chatData }

  const response = { update: { ids: { chatList, chatListEmpty: { hidden: !empty } }}}

  if (argv[0] === "launch") {
    const fileManager = $.NSFileManager.defaultManager
    const cacheDir = envVar("alfred_workflow_cache")
    ;["stream.txt", "pid.txt", "starting", "autopaste"].forEach(file => fileManager.removeItemAtPathError(`${cacheDir}/${file}`, undefined))

  }

  return JSON.stringify(response)
}
