#!/usr/bin/osascript -l JavaScript

// Helpers
function envVar(varName) {
  return $.NSProcessInfo
    .processInfo
    .environment
    .objectForKey(varName).js
}

function fileModified(path) {
  return $.NSFileManager.defaultManager
    .attributesOfItemAtPathError(path, undefined)
    .js["NSFileModificationDate"].js
    .getTime()
}

function appendChat(path, message) {
  const initChatString = $.NSString.stringWithContentsOfFileEncodingError(path, $.NSUTF8StringEncoding, undefined).js
  const ongoingChat = JSON.parse(initChatString).concat(message)
  $(JSON.stringify(ongoingChat)).writeToFileAtomicallyEncodingError(path, true, $.NSUTF8StringEncoding, undefined)
}

// Alfred's Markdown view crashes on a quote that starts with an empty line (">" on its own),
// and on a callout title with nothing under it. Both turn up mid-stream, while Claude is
// part way through writing a quote, so anything shown in the chat goes through here first
function safeMarkdown(text) {
  const isQuote = line => /^\s{0,3}>/.test(line ?? "")
  const isEmptyQuote = line => /^\s{0,3}(>\s*)+$/.test(line ?? "")
  const isCalloutTitle = line => /^\s{0,3}>\s*\[![^\]]*\]\s*$/.test(line ?? "")

  // An empty quote line is fine inside a quote, and dropped when it would start one
  const lines = []
  let inCode = false

  for (const line of text.split("\n")) {
    if (/^\s*(```|~~~)/.test(line)) inCode = !inCode

    if (!inCode && isEmptyQuote(line)) {
      if (isQuote(lines[lines.length - 1])) lines.push(">")
      continue
    }

    lines.push(line)
  }

  // A callout title is dropped until there is something under it
  return lines
    .filter((line, index) => {
      if (isCalloutTitle(line)) {
        let next = index + 1
        while (isEmptyQuote(lines[next])) next++
        return isQuote(lines[next])
      }

      // The empty lines that followed a dropped title go too
      if (isEmptyQuote(line)) {
        let previous = index - 1
        while (isEmptyQuote(lines[previous])) previous--
        if (isCalloutTitle(lines[previous])) {
          let next = index + 1
          while (isEmptyQuote(lines[next])) next++
          return isQuote(lines[next])
        }
      }

      return true
    })
    .join("\n")
}

function endStreaming(chatAreaObj) {
  return runScript("end-streaming", [ JSON.stringify({ ...chatAreaObj, text: safeMarkdown(chatAreaObj.text) }) ])
}

function runScript(name, args) {
  const scriptPath = $.NSFileManager.defaultManager
    .currentDirectoryPath
    .stringByAppendingPathComponent(`scripts/${name}`).js

  const task = $.NSTask.alloc.init
  const stdout = $.NSPipe.pipe

  task.executableURL = $.NSURL.fileURLWithPath(scriptPath)
  task.arguments = args
  task.standardOutput = stdout
  task.launchAndReturnError(false)

  const dataOut = stdout.fileHandleForReading.readDataToEndOfFileAndReturnError(false)
  return $.NSString.alloc.initWithDataEncoding(dataOut, $.NSUTF8StringEncoding).js
}

// The line shown until the reply starts. Thinking counts the seconds from when it began,
// which the first pulse to see it notes in a "thinking" file
function statusLine(blockTypes) {
  if (blockTypes.includes("thinking")) {
    const thinkingFile = `${envVar("alfred_workflow_cache")}/thinking`
    const now = new Date().getTime()
    let started = parseInt($.NSString.stringWithContentsOfFileEncodingError(thinkingFile, $.NSUTF8StringEncoding, undefined).js)
    if (!(started > 0)) {
      started = now
      $(String(now)).writeToFileAtomicallyEncodingError(thinkingFile, true, $.NSUTF8StringEncoding, undefined)
    }

    if (blockTypes[blockTypes.length - 1] !== "tool_use") {
      const seconds = Math.floor((now - started) / 1000)
      if (seconds < 1) return "*Thinking…*"
      return seconds < 60 ? `*Thinking… ${seconds}s*` : `*Thinking… ${Math.floor(seconds / 60)}m ${seconds % 60}s*`
    }
  }

  return blockTypes.includes("tool_use") ? "*Reading the attached files…*" : "*Thinking…*"
}

// Main
function run(argv) {
  const chatFile = argv[0]
  const stopStreaming = envVar("stop_streaming") === "1"
  const timeoutSeconds = parseInt(envVar("timeout_seconds")) || 30
  const streamFile = `${envVar("alfred_workflow_cache")}/stream.txt`

  // First pulse after sending: add the status line under the question. Every later pulse replaces
  // that line, so it has to be there first, even if the reply or an error has already arrived
  const startingFile = `${envVar("alfred_workflow_cache")}/starting`
  if ($.NSFileManager.defaultManager.fileExistsAtPath(startingFile)) {
    $.NSFileManager.defaultManager.removeItemAtPathError(startingFile, undefined)
    return JSON.stringify({ update: { ids: { chatArea: {
      behaviour: { mode: "append", scroll: "end" },
      text: "*Starting Claude…*"
    }}}})
  }
  const streamString = $.NSString.stringWithContentsOfFileEncodingError(streamFile, $.NSUTF8StringEncoding, undefined).js || ""

  // One JSON event per line; the last line may still be half-written
  const lines = streamString.split("\n").filter(line => line.trim())
  const events = lines.flatMap(line => { try { return [JSON.parse(line)] } catch { return [] } })
  const strayOutput = lines.filter(line => !line.trim().startsWith("{")).join("\n")

  const sessionId = events.find(item => item.session_id)?.session_id
  const assistantMessage = content => sessionId
    ? { role: "assistant", content, session_id: sessionId }
    : { role: "assistant", content }

  const responseText = events
    .filter(item => item.type === "stream_event"
      && item.event?.type === "content_block_delta"
      && item.event.delta?.type === "text_delta")
    .map(item => item.event.delta.text)
    .join("")

  // What Claude is doing before the reply starts: thinking, or reading files with a tool
  const blockTypes = events
    .filter(item => item.type === "stream_event" && item.event?.type === "content_block_start")
    .map(item => item.event.content_block?.type)

  const result = events.find(item => item.type === "result")

  // Still streaming
  if (!result) {
    const stalled = new Date().getTime() - fileModified(streamFile) > timeoutSeconds * 1000

    if (stalled) {
      if (responseText.length > 0) appendChat(chatFile, assistantMessage(responseText))

      return endStreaming({
        behaviour: { mode: "replacelast", scroll: "end" },
        text: responseText.length > 0
          ? `${responseText} [Connection Stalled]`
          : (strayOutput || "[No response from Claude Code]")
      })
    }

    if (stopStreaming) {
      appendChat(chatFile, assistantMessage(responseText))

      return endStreaming({
        behaviour: { mode: "replacelast", scroll: "end" },
        text: `${responseText} [Answer Interrupted]`
      })
    }

    if (streamString.length === 0) return

    // Claude Code has started but hasn't written anything yet
    return JSON.stringify({ update: { ids: { chatArea: {
      behaviour: { mode: "replacelast", scroll: "end" },
      text: safeMarkdown(responseText).trim() ? safeMarkdown(responseText) : statusLine(blockTypes)
    }}}})
  }

  // Finished with an error (not logged in, usage limit reached, etc.)
  if (result.is_error) {
    return endStreaming({
      behaviour: { mode: "replacelast" },
      text: `**Error:** ${result.result || result.subtype || "Unknown error"}`
    })
  }

  // Finished normally
  const finalText = typeof result.result === "string" && result.result.length > 0 ? result.result : responseText
  appendChat(chatFile, assistantMessage(finalText))

  // Sent with a preset that pastes its reply back: do that now, which also closes the window
  const autoPaste = $.NSFileManager.defaultManager.fileExistsAtPath(`${envVar("alfred_workflow_cache")}/autopaste`)

  const ended = endStreaming({
    behaviour: { mode: "replacelast", scroll: "end" },
    text: finalText
  })

  if (autoPaste) {
    const pasted = runScript("paste-reply", [chatFile])
    if (pasted.includes('"finish"')) return pasted
  }

  return ended
}
