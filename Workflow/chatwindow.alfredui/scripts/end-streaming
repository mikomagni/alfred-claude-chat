#!/usr/bin/osascript -l JavaScript

// Helpers
function envVar(varName) {
  return $.NSProcessInfo
    .processInfo
    .environment
    .objectForKey(varName).js
}

function readFile(path) {
  return $.NSString.stringWithContentsOfFileEncodingError(path, $.NSUTF8StringEncoding, undefined).js
}

function kill(pid) {
  ObjC.import("signal")
  $.kill(pid, $.SIGTERM)
}

// Main
function run(argv) {
  const chatAreaObj = JSON.parse(argv[0] || "{}")
  const pidStreamFile = `${envVar("alfred_workflow_cache")}/pid.txt`
  const streamFile = `${envVar("alfred_workflow_cache")}/stream.txt`

  // Guard: kill(0) would signal the whole process group
  const pid = parseInt(readFile(pidStreamFile))
  if (pid > 0) kill(pid)

  const fileManager = $.NSFileManager.defaultManager
  fileManager.removeItemAtPathError(pidStreamFile, undefined)
  fileManager.removeItemAtPathError(streamFile, undefined)
  fileManager.removeItemAtPathError(`${envVar("alfred_workflow_cache")}/starting`, undefined)
  fileManager.removeItemAtPathError(`${envVar("alfred_workflow_cache")}/thinking`, undefined)
  fileManager.removeItemAtPathError(`${envVar("alfred_workflow_cache")}/autopaste`, undefined)

  return JSON.stringify({
    pulse: { interval: 0.5 },
    variables: { stop_streaming: false, preset: "", attachments: "" },
    update: { relayout: true, ids: {
      chatArea: chatAreaObj,
      submitPromptButton: {
        image: { type: "symbol", src: "arrow.up.circle.fill" },
        events: [{ triggers: "actioned", action: "{var:submit_prompt}" }]
      },
      newChatButton: { enabled: true },
      deleteAllButton: { enabled: true },
      presetsButton: { enabled: true, text: "Presets" },
      regenerateButton: { enabled: true },
      pasteReplyButton: { enabled: true },
      attachButton: { enabled: true },
      attachmentsButton: { text: "", hidden: true },
      chatList: { enabled: true },
      promptField: { enabled: true, focus: true, text: "" }
    }}
  })
}
