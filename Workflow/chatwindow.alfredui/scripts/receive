#!/usr/bin/osascript -l JavaScript

// Picks up text sent to the chat window from elsewhere (Universal Action, Hotkey or keyword).
// The workflow leaves it in inbox.json, so it arrives whether the window was already open or not.
// With a preset, a new chat is started and sent straight away. Without one, the text waits in the message box.
// Files arrive the same way and become attachments.

function envVar(varName) {
  return $.NSProcessInfo
    .processInfo
    .environment
    .objectForKey(varName).js
}

function scriptPath(name) {
  return $.NSFileManager.defaultManager.currentDirectoryPath.stringByAppendingPathComponent(`scripts/${name}`).js
}

function runScript(name, args, wait) {
  const task = $.NSTask.alloc.init
  const stdout = $.NSPipe.pipe

  task.executableURL = $.NSURL.fileURLWithPath(scriptPath(name))
  task.arguments = args
  task.standardInput = $.NSFileHandle.fileHandleWithNullDevice
  task.standardOutput = wait ? stdout : $.NSFileHandle.fileHandleWithNullDevice
  task.standardError = $.NSFileHandle.fileHandleWithNullDevice
  task.launchAndReturnError(false)
  if (!wait) return

  const data = stdout.fileHandleForReading.readDataToEndOfFileAndReturnError(false)
  return $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js
}

// Bring the chat window forward if it was already open behind other apps
function activateWindow() {
  ObjC.import("AppKit")
  ObjC.import("unistd")
  $.NSRunningApplication.runningApplicationWithProcessIdentifier($.getppid())
    ?.activateWithOptions($.NSApplicationActivateIgnoringOtherApps)
}

function run() {
  const inboxFile = `${envVar("alfred_workflow_cache")}/inbox.json`
  const inboxString = $.NSString.stringWithContentsOfFileEncodingError(inboxFile, $.NSUTF8StringEncoding, undefined).js
  $.NSFileManager.defaultManager.removeItemAtPathError(inboxFile, undefined)

  let inbox
  try { inbox = JSON.parse(inboxString) } catch { return }

  // Files sent from elsewhere are imported the same way as ones attached in the window
  const files = Array.isArray(inbox.files) ? inbox.files : []
  const attached = files.length > 0
    ? JSON.parse(runScript("attach", ["add", "[]", JSON.stringify(files)], true) || "{}")
    : {}
  const attachments = attached.variables?.attachments || []
  const hasPreset = Boolean(inbox.preset?.prompt)

  const text = (inbox.text || "").trim() || (attachments.length > 0 && hasPreset ? "See the attached files." : "")
  if (!text && files.length === 0) return

  activateWindow()

  // Files without a preset, or files that couldn't be attached: a new chat, ready for a question
  if (files.length > 0 && (!hasPreset || attachments.length === 0)) return JSON.stringify({
    ...attached,
    variables: { ...attached.variables, current_chat_file: null },
    update: { relayout: true, ids: {
      ...attached.update?.ids,
      chatArea: { behaviour: { mode: "replace" }, text: "" },
      promptField: { text: "", focus: true }
    }},
    functions: { ids: { chatList: "selectnone" } }
  })

  // No preset: start a new chat with the text ready to edit
  if (!inbox.preset?.prompt) return JSON.stringify({
    variables: { current_chat_file: null },
    update: { ids: {
      chatArea: { behaviour: { mode: "replace" }, text: "" },
      promptField: { text: text, focus: true }
    }},
    functions: { ids: { chatList: "selectnone" } }
  })

  // Preset: the same steps as pressing ↩ in a new chat
  const preset = JSON.stringify(inbox.preset)
  const attachmentsArg = JSON.stringify(attachments)
  const response = JSON.parse(runScript("prepare-for-streaming", ["", text, preset, attachmentsArg], true))
  response.update.ids.chatArea.behaviour = { mode: "replace" }
  response.functions = { ids: { chatList: "selectfirst" } }

  runScript("submit-prompt", [response.variables.current_chat_file, text, preset, "", "", attachmentsArg], false)

  // The preset asks for its reply to be pasted back as soon as it arrives
  if (inbox.preset.paste) $.NSFileManager.defaultManager.createFileAtPathContentsAttributes(
    `${envVar("alfred_workflow_cache")}/autopaste`, undefined, undefined)

  return JSON.stringify(response)
}
