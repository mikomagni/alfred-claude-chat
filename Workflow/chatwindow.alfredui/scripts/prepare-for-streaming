#!/usr/bin/osascript -l JavaScript

function envVar(varName) {
  return $.NSProcessInfo
    .processInfo
    .environment
    .objectForKey(varName).js
}

// With a preset, the instruction goes in front of the text. The chat shows the preset's name
// above the text instead, and the chat list shows "Preset: text"
function composeMessage(prompt, presetArg) {
  let preset
  try { preset = JSON.parse(presetArg) } catch {}
  if (typeof preset === "string") try { preset = JSON.parse(preset) } catch {}
  if (!preset?.prompt) return { content: prompt }

  const text = prompt.trim()
  return {
    content: `${preset.prompt}\n\n"""\n${text}\n"""`,
    title: `${preset.name}: ${text}`,
    display: `**${preset.name}**\n\n${text}`
  }
}

function run(argv) {
  const chatFile = argv[0]
  const prompt = argv[1]
  const message = composeMessage(prompt, argv[2])

  if (prompt.trim().length === 0) return JSON.stringify({ sound: { src: "Basso" }})

  // An empty stream file marks a reply as on its way, before Claude Code has even started.
  // "starting" tells the first pulse to show the Starting Claude… line
  const cacheDir = envVar("alfred_workflow_cache")
  const fileManager = $.NSFileManager.defaultManager
  fileManager.createDirectoryAtPathWithIntermediateDirectoriesAttributesError(cacheDir, true, undefined, undefined)
  fileManager.createFileAtPathContentsAttributes(`${cacheDir}/stream.txt`, undefined, undefined)
  fileManager.createFileAtPathContentsAttributes(`${cacheDir}/starting`, undefined, undefined)

  const response = {
    pulse: { interval: 0.1 },
    update: { ids: {
      chatArea: {
        behaviour: { mode: "append" },
        text: `\n\n> [!alfredSelectedResultBackgroundColor:questionmark.circle:Question]\n${(message.display || message.content).split("\n").map(line => `> ${line}  `).join("\n")}\n\n`
      },
      submitPromptButton: {
        image: { type: "symbol", src: "stop.circle.fill" },
        events: [{
          triggers: "actioned",
          action: { variables: { stop_streaming: true } }
        }]
      },
      newChatButton: { enabled: false },
      deleteAllButton: { enabled: false },
      presetsButton: { enabled: false },
      regenerateButton: { enabled: false },
      chatList: { enabled: false },
      promptField: { enabled: false }
    }}
  }

  if (chatFile.length === 0) {
    const uuid = $.NSProcessInfo.processInfo.globallyUniqueString.js.replace(/-.*/, "")

    const now = new Date()
    const padDate = number => number.toString().padStart(2, "0")

    const dateTime = [
      now.getFullYear(),
      padDate(now.getMonth() + 1),
      padDate(now.getDate()),
      padDate(now.getHours()),
      padDate(now.getMinutes()),
      padDate(now.getSeconds()),
    ].join(".")

    const newChatFile = $(envVar("alfred_workflow_data")).stringByAppendingPathComponent(`${dateTime}-${uuid}.json`).js

    response.variables = { current_chat_file: newChatFile }
    response.update.ids.chatList.hidden = false
    response.update.ids.chatListEmpty = { hidden: true }
    response.update.ids.chatList.data = { modify: { insert: {
      position: "before",
      src: [{
        "uid": newChatFile,
        "chatName.text": message.title || prompt
      }]
    }}}
  }

  return JSON.stringify(response)
}
